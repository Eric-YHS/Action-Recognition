/* miniprogram/pages/record/record.wxss */

page {
  width: 100%;
  height: 100%;
}

.record {
  width: 100%;
  height: 100%;
  background: white;
}

.loading {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.loading view {
  text-align: center;
  width: 90%;
  height: 150rpx;
  line-height: 150rpx;
  font-weight: bold;
  font-size: 40rpx;
  color: white;
  background: skyblue;
  border-radius: 25rpx;
  margin: 50rpx 0rpx -50rpx 0rpx;
}

.loading image {
  border: 2rpx gray;
  width: 90%;
  margin-top: -40rpx;
}

.choosebutton {
  margin: 0rpx 20rpx 0rpx 20rpx;
}

.choosebutton button:nth-child(1) {
  margin-bottom: 20rpx;
  background: #f76785;
  color: white;
  border-radius: 25rpx;
}

.choosebutton button:nth-child(2) {
  margin-bottom: 20rpx;
  background: #fdab86;
  color: white;
  border-radius: 25rpx;
}

.choosebutton button:nth-child(3) {
  margin-bottom: 20rpx;
  background: #55b682;
  color: white;
  border-radius: 25rpx;
}

.info {
  border: 1rpx solid skyblue;
  padding: 20rpx 0rpx 20rpx 0rpx;
  border-radius: 25rpx;
  margin: -90rpx 20rpx 0rpx 20rpx;
}

.inputnum {
  height: 70rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 30rpx 20rpx 30rpx 20rpx;
  border: 2rpx solid black;
  border-radius: 15rpx;
}

.inputnum text {
  display: inline-block;
  height: 100%;
  border-right: 2rpx solid;
  line-height: 70rpx;
}

.inputnum input {
  width: 70%;
  margin-left: 20rpx;
}
